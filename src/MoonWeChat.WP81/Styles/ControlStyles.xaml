<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="IconButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ChatInputTextBoxStyle" TargetType="TextBox">
    <Setter Property="Background" Value="{ThemeResource InputBoxBackgroundBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{ThemeResource FontBody}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="MaxHeight" Value="96" />
  </Style>
  <Style x:Key="FlatListViewItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="SendButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnMineBubbleTextBrush}" />
    <Setter Property="FontSize" Value="{ThemeResource FontSubtitle}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="MorePanelButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{ThemeResource PageTitleFontSize}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{ThemeResource FontBody}" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
  </Style>
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{ThemeResource FontSubtitle}" />
    <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
  </Style>
</ResourceDictionary>
