<Page
    x:Class="MoonWeChat.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoonWeChat.Views"
    xmlns:converters="using:MoonWeChat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource ChatWallpaperBrush}">

    <!--
        聊天会话页：单聊/群聊共用同一个页面。区分方式是 ViewModel.IsGroup ——
        群聊消息气泡会带发送者昵称/头像（BubbleRowTemplate 里已经处理），这个页面本身
        只关心“标题栏怎么显示”“输入栏/‘+’更多面板要不要出现群相关的入口”这两件事。
        气泡模板、类型选择器都在 Styles/MessageBubbleTemplates.xaml，已经合并进 App 资源，
        这里直接用 StaticResource 取。

        视觉上按 10586(November Update) 时代的扁平 Metro 风格：直角无圆角，元素间距一律用
        Margin（不用 Grid.ColumnSpacing/RowSpacing 或 StackPanel.Spacing —— 这几个是 Fall
        Creators Update 才加进 UWP 的新属性，10586 上没有）。
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="More" Label="更多">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="撤回我的上一条" Click="OnRevokeClick" />
                        <MenuFlyoutItem Text="拍一拍" Click="OnPatClick" />
                        <MenuFlyoutItem x:Name="MuteMenuItem" Text="设置消息免打扰" Click="OnToggleMuteClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WP8.1 页面标题：硬件返回键负责返回，标题左对齐并从 19px 起始。 -->
        <StackPanel Grid.Row="0" Margin="19,12,12,8">
            <TextBlock x:Name="HeaderTitleText" Style="{StaticResource PageTitleTextStyle}"
                       FontSize="{ThemeResource TextHeroFontSize}"
                       FontWeight="Light"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- ============ 消息列表 ============ -->
        <ListView Grid.Row="1"
                  x:Name="MessageListView"
                  ItemsSource="{Binding ViewModel.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource MessageRowTemplateSelector}"
                  ItemContainerStyle="{StaticResource FlatListViewItemStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnMessageClick"
                  Padding="0,8,0,72"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- 引用条 -->
        <Border Grid.Row="2" x:Name="QuoteBar" Visibility="Collapsed"
                Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QuotePreviewText" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="×" Padding="8,2" Click="OnClearQuoteClick" />
            </Grid>
        </Border>

        <!--
            发送状态条：示例模式提示 / 正在发送 / 发送失败原因。
            这条必须存在 —— ChatViewModel.SendAsync 失败时只写 SendStatusText，
            没有这块 UI 用户会以为消息已经发到电脑微信。
        -->
        <Border Grid.Row="3" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="12,6"
                Visibility="{Binding ViewModel.HasSendStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ViewModel.SendStatusText, Mode=OneWay}"
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource WarningTextBrush}" />
        </Border>

        <!-- ============ 输入栏 ============ -->
        <Border Grid.Row="4" Background="{ThemeResource InputBarBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Click="OnVoiceModeToggleClick">
                    <SymbolIcon x:Name="VoiceModeIcon" Symbol="Microphone" />
                </Button>

                <!--
                    这里没有用 x:Bind TwoWay——实测这套 SDK 的 x:Bind 编译器不认
                    UpdateSourceEventName 这个参数（会直接报 WMC0011），而 TwoWay 默认要等
                    失焦才回写源，达不到“打字的同时‘+’按钮实时变成‘发送’”的效果。
                    干脆用 OneWay 显示 + 后台 TextChanged 事件手动回写 DraftText，简单可靠。
                -->
                <TextBox Grid.Column="1" x:Name="InputTextBox" Style="{StaticResource ChatInputTextBoxStyle}"
                         Text="{Binding ViewModel.DraftText, Mode=OneWay}"
                         TextChanged="OnInputTextChanged"
                         PlaceholderText="发消息…"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center" />

                <Border Grid.Column="1" x:Name="VoiceHoldButton"
                        Background="{ThemeResource InputBoxBackgroundBrush}"
                        Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                        PointerPressed="OnVoiceHoldPressed" PointerReleased="OnVoiceHoldReleased"
                        PointerCanceled="OnVoiceHoldReleased" PointerCaptureLost="OnVoiceHoldReleased">
                    <TextBlock x:Name="VoiceHoldText" Text="按住 说话" FontSize="{ThemeResource TextSecondaryFontSize}" HorizontalAlignment="Center"
                               Padding="0,9" Foreground="{ThemeResource PrimaryTextBrush}" />
                </Border>

                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0">
                    <TextBlock Text="☺" FontSize="{ThemeResource TextBodyFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <Flyout x:Name="EmojiFlyout" Placement="Top">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👍" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" />
                                <Button Content="😂" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="❤️" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="😭" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="😡" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="🎉" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="🙏" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                                <Button Content="😅" FontSize="{ThemeResource PageTitleFontSize}" Click="OnEmojiPicked" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Grid.Column="3" Content="发送" Click="OnSendClick" Margin="8,0,0,0"
                        Style="{StaticResource SendButtonStyle}"
                        IsEnabled="{Binding ViewModel.CanSend, Mode=OneWay}"
                        Visibility="{Binding ViewModel.ShowSendButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="OnMoreClick" Margin="8,0,0,0"
                        Visibility="{Binding ViewModel.ShowSendButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Grid>
        </Border>
        <Border Grid.Row="4" x:Name="InputBottomPadding" Height="0" Background="Transparent" VerticalAlignment="Bottom" />

        <!-- ============ “+” 更多面板：对应 WeChatPadPro 能发的非文本消息类型入口 ============ -->
        <Border Grid.Row="5" x:Name="MorePanel" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Grid Margin="16,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="album">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="图" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="相册" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="camera" Margin="4,0,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="摄" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="拍摄" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="video" Margin="4,0,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="视" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="视频" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="location" Margin="4,0,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="位" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="位置" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="card" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="人" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="名片" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MorePanelButtonStyle}" Click="OnMorePanelItemClick" Tag="file" Margin="4,16,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="件" FontSize="{ThemeResource TextBodyFontSize}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="文件" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryTextBrush}" />
                    </StackPanel>
                </Button>
                <!-- 红包 / 转账已移除：不做资金相关能力 -->
            </Grid>
        </Border>
    </Grid>
</Page>
