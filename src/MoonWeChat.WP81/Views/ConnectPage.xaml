<Page
    x:Class="MoonWeChat.Views.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <!--
        远程连接向导：WP 上唯一必做的配置入口。
        只关心「电脑网关在哪 + Token 是什么」，不涉及本机部署微信。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="48" Margin="4,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Click="OnBackClick">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <TextBlock Grid.Column="1" Text="连接远程服务器" FontSize="{ThemeResource TextBodyFontSize}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,28" MaxWidth="520">

                <TextBlock TextWrapping="Wrap" FontSize="{ThemeResource TextSecondaryFontSize}" Margin="0,0,0,14"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="选择后端协议并填写服务器地址。pyweixin 网关跑在电脑上（默认 18765）；WeChatPadPro 默认 8062，App 会自动补 /api 基路径。" />

                <!-- 步骤 0：后端协议 -->
                <TextBlock Text="0. 后端协议" FontSize="{ThemeResource TextSecondaryFontSize}" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <StackPanel Margin="0,6,0,14">
                    <RadioButton x:Name="BackendPyRadio" Content="pyweixin 网关（电脑 RPA）"
                                 GroupName="BackendKind" Click="OnBackendClick" />
                    <RadioButton x:Name="BackendPadRadio" Content="WeChatPadPro（iPad 协议）"
                                 GroupName="BackendKind" Margin="0,6,0,0" Click="OnBackendClick" />
                </StackPanel>

                <!-- 步骤 1：地址 -->
                <TextBlock Text="1. 服务器地址" FontSize="{ThemeResource TextSecondaryFontSize}" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="完整 URL，或 host:端口" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="ServerBox" Margin="0,4,0,4"
                         PlaceholderText="pyweixin: 192.168.1.10:18765 ｜ WeChatPadPro: 192.168.1.10:8062"
                         TextChanged="OnServerChanged" />
                <TextBlock x:Name="NormalizedUrlText" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,0,0,12"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="规范化后：—" />

                <!-- 步骤 2：Token -->
                <TextBlock Text="2. Token（业务鉴权码）" FontSize="{ThemeResource TextSecondaryFontSize}" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock TextWrapping="Wrap" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="填网关启动时打印的 token；或用下方 AdminKey 让本 App 代为生成。" />
                <TextBox x:Name="TokenBox" Margin="0,4,0,12"
                         PlaceholderText="粘贴 TokenKey"
                         TextChanged="OnTokenChanged" />

                <!-- 可选：AdminKey 生成 -->
                <TextBlock Text="可选 · 用 AdminKey 生成 Token" FontSize="{ThemeResource TextSecondaryFontSize}" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="AdminKey（服务启动日志）" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,4,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
                <PasswordBox x:Name="AdminKeyBox" Margin="0,4,0,6" />
                <Button Content="生成 Token 并填入" Margin="0,0,0,16"
                        HorizontalAlignment="Stretch" Padding="12,8"
                        Click="OnGenTokenClick" />

                <!-- 可选代理 -->
                <TextBlock Text="可选 · 代理（云服务器登录时）" FontSize="{ThemeResource TextSecondaryFontSize}" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBox x:Name="ProxyBox" Margin="0,4,0,16"
                         PlaceholderText="http://user:pass@host:port"
                         TextChanged="OnProxyChanged" />

                <!-- 状态 -->
                <Border Background="{ThemeResource ChromeBackgroundBrush}" Padding="12" Margin="0,0,0,12"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1">
                    <TextBlock x:Name="StatusText" Text="填好地址和 Token 后，先点「测试连接」。"
                               TextWrapping="Wrap" FontSize="{ThemeResource TextSecondaryFontSize}"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                </Border>

                <Button x:Name="TestButton" Content="测试连接"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10"
                        Click="OnTestClick" />
                <Button x:Name="SaveButton" Content="保存并去扫码登录"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Style="{StaticResource SendButtonStyle}"
                        Click="OnSaveAndLoginClick" />
                <Button Content="保存并稍后登录（先看示例 UI）"
                        HorizontalAlignment="Stretch" Padding="12,10"
                        Click="OnSaveOnlyClick" />

                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="{ThemeResource TextCaptionFontSize}"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="电脑跑 server/pyweixin_gateway，手机只连这个 HTTP 口。默认端口 18765。穿透时只暴露网关端口，注意 Token 保密。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
