<Page x:Class="MoonWeChat.Views.ChatListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:MoonWeChat.Controls" Background="{ThemeResource ListBackgroundBrush}">
  <Page.BottomAppBar><CommandBar><AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" /></CommandBar></Page.BottomAppBar>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="微信" Style="{StaticResource PageTitleTextStyle}" Margin="19,12,12,12" /><ListView Grid.Row="1" Padding="0,0,0,72" ItemsSource="{Binding ViewModel.Sessions}" IsItemClickEnabled="True" ItemClick="OnItemClick" ItemContainerStyle="{StaticResource FlatListViewItemStyle}"><ListView.ItemTemplate><DataTemplate><Grid Margin="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:AvatarView DisplayName="{Binding DisplayName}" AccentColorHex="{Binding AvatarAccentColor}" ImageUrl="{Binding AvatarUrl}" Size="52" /><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" /><TextBlock Text="{Binding PreviewText}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
</Page>
