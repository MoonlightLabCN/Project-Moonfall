<Page
    x:Class="MoonWeChat.Views.MomentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonWeChat.Controls"
    xmlns:converters="using:MoonWeChat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource ListBackgroundBrush}">

    <!--
        朋友圈子页：WP 风格（大标题 + 应用栏返回），不是底部 Tab 旧壳。
        从 MainHub「发现」点进；返回走 Frame.GoBack / MainHubPage。
    -->

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Back" Label="返回" Click="OnBackClick" />
            <AppBarButton Icon="Refresh" Label="刷新" Click="OnRefreshClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="19,12,12,8">
            <TextBlock Text="朋友圈" FontSize="{ThemeResource TextHeroFontSize}" FontWeight="Light"
                       Foreground="{ThemeResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding ViewModel.StatusText, Mode=OneWay}" FontSize="{ThemeResource TextSecondaryFontSize}" Margin="0,4,0,0"
                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DraftBox"
                         PlaceholderText="这一刻的想法…"
                         Text="{Binding ViewModel.Draft, Mode=TwoWay}"
                         TextChanged="OnDraftChanged"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MaxHeight="72"
                         BorderThickness="0"
                         Background="{ThemeResource InputBoxBackgroundBrush}"
                         Padding="10,8" />
                <Button Grid.Column="1" Content="发表" Margin="8,0,0,0"
                        Style="{StaticResource SendButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="OnPublishClick" />
            </Grid>
        </Border>

        <ListView Grid.Row="2"
                  x:Name="MomentsList"
                  ItemsSource="{Binding ViewModel.Posts, Mode=OneWay}"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource FlatListViewItemStyle}"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  Padding="0,4,0,72">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="14,12" Background="{ThemeResource ListBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:AvatarView Grid.Column="0"
                                                  DisplayName="{Binding AuthorName}"
                                                  AccentColorHex="{Binding AuthorAccent}"
                                                  ImageUrl="{Binding AuthorAvatarUrl}"
                                                  Size="44" />

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding AuthorName}" FontSize="{ThemeResource TextBodyFontSize}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentBrush}" />
                                <TextBlock Text="{Binding Content}" FontSize="{ThemeResource TextSecondaryFontSize}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{ThemeResource PrimaryTextBrush}" />

                                <TextBlock Text="{Binding Location}" FontSize="{ThemeResource TextCaptionFontSize}" Margin="0,6,0,0"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TimeText}" FontSize="{ThemeResource TextCaptionFontSize}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <Button Content="赞" Margin="16,0,0,0" Padding="10,4"
                                            Tag="{Binding}"
                                            Click="OnLikeClick"
                                            FontSize="{ThemeResource TextCaptionFontSize}" />
                                    <Button Content="评论" Margin="8,0,0,0" Padding="10,4"
                                            Tag="{Binding}"
                                            Click="OnCommentClick"
                                            FontSize="{ThemeResource TextCaptionFontSize}" />
                                </StackPanel>

                                <Border Background="{ThemeResource ChromeBackgroundBrush}"
                                        Padding="8,6" Margin="0,8,0,0"
                                        Visibility="{Binding HasLikes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock FontSize="{ThemeResource TextCaptionFontSize}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource AccentBrush}">
                                        <Run Text="♡ " /><Run Text="{Binding LikesText}" />
                                    </TextBlock>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Comments}" Margin="0,6,0,0"
                                              Visibility="{Binding HasComments, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" FontSize="{ThemeResource TextCaptionFontSize}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Foreground="{ThemeResource PrimaryTextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
