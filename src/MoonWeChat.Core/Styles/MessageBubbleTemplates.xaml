<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MoonWeChat.Converters"
    xmlns:controls="using:MoonWeChat.Controls"
    xmlns:common="using:MoonWeChat.Common">

    <!--
        消息气泡相关的全部模板都放在这一个文件里，方便对照 docs/WeChatPadPro-API-notes.md
        逐条核对“后端支持的消息类型 -> 这里是不是有对应模板”。

        视觉上按 Windows 10 版本 1511(10586, November Update) 那个年代的扁平 Metro 风格来：
        所有色块/卡片一律直角，不用 CornerRadius；元素间距一律用 Margin，不用 Grid 的
        ColumnSpacing/RowSpacing 或 StackPanel 的 Spacing——这几个属性是 Fall Creators Update
        (10.0.16299) 才加进 UWP 的，10586 时代没有，真机上用了会在运行时报错。

        转换器实例在本文件内直接声明（不依赖别的资源字典），跨文件 StaticResource 容易踩坑，
颜色类资源已经全部改成 ThemeResource（见 Styles/Themes 下的主题字典），这里的
        转换器则保持“各文件自己声明自己要用的”这个更保险的做法。
    -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    <converters:MineToBubbleBrushConverter x:Key="MineToBubbleBrushConverter" />
    <converters:MineToTextBrushConverter x:Key="MineToTextBrushConverter" />
    <converters:MineToAlignmentConverter x:Key="MineToAlignmentConverter" />
    <converters:AccentHexToBrushConverter x:Key="AccentHexToBrushConverter" />

    <!-- ============ 行级模板：时间分隔线 ============ -->
    <DataTemplate x:Key="DateDividerRowTemplate">
        <TextBlock Text="{Binding Content}"
                   FontSize="{ThemeResource FontCaption}"
                   Margin="0,14,0,6"
                   Foreground="{ThemeResource SecondaryTextBrush}"
                   HorizontalAlignment="Center" />
    </DataTemplate>

    <!-- ============ 行级模板：居中系统提示（撤回 / 拍一拍 / 入群公告） ============ -->
    <DataTemplate x:Key="SystemNoticeRowTemplate">
        <Border Background="{ThemeResource PillBackgroundBrush}"
                Padding="10,5"
                Margin="50,8,50,8"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding Content}"
                       FontSize="{ThemeResource FontCaption}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：文本（含引用/回复块） ============ -->
    <DataTemplate x:Key="TextTemplate">
        <Border Background="{Binding IsMine, Converter={StaticResource MineToBubbleBrushConverter}}"
                Padding="12,9">
            <StackPanel>
                <Border Background="{ThemeResource PillBackgroundBrush}"
                        Padding="8,5"
                        Margin="0,0,0,6"
                        Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding QuotedSenderName}"
                                   FontSize="{ThemeResource FontCaption}"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   Foreground="{Binding IsMine, Converter={StaticResource MineToTextBrushConverter}}" />
                        <TextBlock Text="{Binding QuotedContent}"
                                   FontSize="{ThemeResource FontCaption}"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   Foreground="{Binding IsMine, Converter={StaticResource MineToTextBrushConverter}}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Content}"
                           FontSize="{ThemeResource FontBody}"
                           TextWrapping="Wrap"
                           Foreground="{Binding IsMine, Converter={StaticResource MineToTextBrushConverter}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：图片（示例数据没有真实图床，用色块 + 图片图标占位） ============ -->
    <DataTemplate x:Key="ImageTemplate">
        <Border Width="{Binding MediaDisplayWidth}"
                Height="{Binding MediaDisplayHeight}"
                Background="{Binding MediaAccentColor, Converter={StaticResource AccentHexToBrushConverter}}">
            <FontIcon Glyph="&#xEB9F;"
                      FontFamily="Segoe MDL2 Assets"
                      FontSize="{ThemeResource FontTitle}"
                      Foreground="{ThemeResource MediaGlyphBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：表情包/动图（真实 Emoji 字符代替贴纸图，无气泡背景） ============ -->
    <DataTemplate x:Key="EmojiTemplate">
        <TextBlock Text="{Binding Content}" FontSize="{ThemeResource FontIcon}" Margin="0,2" />
    </DataTemplate>

    <!-- ============ 内容模板：语音（气泡宽度按时长变化 + 未读绿点） ============ -->
    <DataTemplate x:Key="VoiceTemplate">
        <Border Background="{Binding IsMine, Converter={StaticResource MineToBubbleBrushConverter}}"
                Padding="12,10"
                Width="{Binding VoiceBubbleWidth}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE720;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="{ThemeResource FontBody}"
                          Foreground="{Binding IsMine, Converter={StaticResource MineToTextBrushConverter}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding VoiceDurationText}"
                           FontSize="{ThemeResource FontBody}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Foreground="{Binding IsMine, Converter={StaticResource MineToTextBrushConverter}}" />
                <Ellipse Grid.Column="2"
                         Width="7" Height="7"
                         Margin="6,0,0,0"
                         Fill="{ThemeResource UnreadBadgeBrush}"
                         VerticalAlignment="Top"
                         Visibility="{Binding IsVoiceUnread, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：视频（封面色块 + 播放图标 + 时长角标） ============ -->
    <DataTemplate x:Key="VideoTemplate">
        <Border Width="{Binding MediaDisplayWidth}"
                Height="{Binding MediaDisplayHeight}"
                Background="{Binding MediaAccentColor, Converter={StaticResource AccentHexToBrushConverter}}">
            <Grid>
                <FontIcon Glyph="&#xE768;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="{ThemeResource FontTitle}"
                          Foreground="{ThemeResource MediaGlyphBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <Border Background="{ThemeResource MediaOverlayBrush}"
                        Padding="5,2"
                        Margin="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding DurationText}" FontSize="{ThemeResource FontCaption}" Foreground="{ThemeResource OnAccentTextBrush}" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：文件（图标 + 文件名 + 后缀/大小） ============ -->
    <DataTemplate x:Key="FileTemplate">
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Padding="12"
                Width="230">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" Background="{ThemeResource AccentBrush}">
                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontCaption}" Foreground="{ThemeResource OnAccentTextBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}"
                               FontSize="{ThemeResource FontBody}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock FontSize="{ThemeResource FontCaption}" Margin="0,3,0,0" Foreground="{ThemeResource SecondaryTextBrush}">
                        <Run Text="{Binding FileExtension}" />
                        <Run Text=" · " />
                        <Run Text="{Binding FileSizeText}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：位置（地图色块 + 地点名 + 地址） ============ -->
    <DataTemplate x:Key="LocationTemplate">
        <!-- 地图缩略图无论深色/浅色主题都保持浅色地图配色，这点和真实微信一致：地图瓦片本身不跟随系统主题反色。 -->
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Width="220">
            <StackPanel>
                <Grid Height="100" Background="{ThemeResource MapBackgroundBrush}">
                    <FontIcon Glyph="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontTitle}" Foreground="{ThemeResource MapPinBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <!-- StackPanel.Padding 是 UWP 才有的属性，WP8.1 会报 WMC0011；用 Margin 等效。 -->
                <StackPanel Margin="10,8">
                    <TextBlock Text="{Binding LocationName}"
                               FontSize="{ThemeResource FontBody}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding LocationAddress}"
                               FontSize="{ThemeResource FontCaption}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：名片（分享联系人） ============ -->
    <DataTemplate x:Key="ContactCardTemplate">
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Padding="12"
                Width="220">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:AvatarView Grid.Column="0"
                                          DisplayName="{Binding CardName}"
                                          AccentColorHex="{Binding CardAvatar}"
                                          Size="36" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CardName}"
                               FontSize="{ThemeResource FontBody}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,8" />
                <TextBlock Text="个人名片" FontSize="{ThemeResource FontCaption}" Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：图文链接分享 ============ -->
    <DataTemplate x:Key="LinkTemplate">
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Padding="10"
                Width="230">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LinkTitle}"
                               FontSize="{ThemeResource FontBody}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding LinkSource}"
                               FontSize="{ThemeResource FontCaption}"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Width="48" Height="48" Margin="10,0,0,0"
                        Background="{Binding MediaAccentColor, Converter={StaticResource AccentHexToBrushConverter}}">
                    <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontCaption}" Foreground="{ThemeResource MediaGlyphBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============ 内容模板：小程序卡片 ============ -->
    <DataTemplate x:Key="MiniProgramTemplate">
        <Border Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Width="220">
            <StackPanel>
                <Border Height="90"
                        Background="{Binding MediaAccentColor, Converter={StaticResource AccentHexToBrushConverter}}" />
                <TextBlock Text="{Binding MiniProgramTitle}"
                           FontSize="{ThemeResource FontBody}"
                           Margin="10,8,10,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding MiniProgramAppName}"
                           FontSize="{ThemeResource FontCaption}"
                           Padding="10,5"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============ 内容选择器：按 MessageType 选模板（无红包/转账） ============ -->
    <common:BubbleContentTemplateSelector x:Key="BubbleContentTemplateSelector"
                                           TextTemplate="{StaticResource TextTemplate}"
                                           ImageTemplate="{StaticResource ImageTemplate}"
                                           EmojiTemplate="{StaticResource EmojiTemplate}"
                                           VoiceTemplate="{StaticResource VoiceTemplate}"
                                           VideoTemplate="{StaticResource VideoTemplate}"
                                           FileTemplate="{StaticResource FileTemplate}"
                                           LocationTemplate="{StaticResource LocationTemplate}"
                                           ContactCardTemplate="{StaticResource ContactCardTemplate}"
                                           LinkTemplate="{StaticResource LinkTemplate}"
                                           MiniProgramTemplate="{StaticResource MiniProgramTemplate}" />

    <!-- ============ 行级模板：普通气泡行（左右分布 + 头像 + 发送者名 + 内容 + 失败提示） ============ -->
    <DataTemplate x:Key="BubbleRowTemplate">
        <Grid Margin="12,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <controls:AvatarView Grid.Column="0"
                                  DisplayName="{Binding SenderName}"
                                  AccentColorHex="{Binding SenderAvatar}"
                                  ImageUrl="{Binding SenderAvatar}"
                                  Size="40"
                                  VerticalAlignment="Top"
                                  Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

            <!--
                气泡宽度上限。不用百分比：这套模板放在 App 级 ResourceDictionary 里，
                DataTemplate 内拿不到 ElementName 去绑 ListView.ActualWidth。
                420 在手机上够不到（内容列本身就只有 ~344，由列宽兜住），
                在桌面/平板全屏时又不会把聊天挤成一条 260px 的窄带。
            -->
            <StackPanel Grid.Column="1"
                        MaxWidth="420"
                        Margin="8,0"
                        HorizontalAlignment="{Binding IsMine, Converter={StaticResource MineToAlignmentConverter}}">
                <TextBlock Text="{Binding SenderName}"
                           FontSize="{ThemeResource FontCaption}"
                           Margin="4,0,4,3"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Visibility="{Binding ShowSenderName, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--
                    HorizontalAlignment 显式跟 IsMine 绑定（而不是留默认的 Stretch）很关键：
                    StackPanel 里只要有任何一个兄弟元素（比如“发送失败”提示）比气泡本身宽，
                    ContentControl 默认的 Stretch 对齐会把气泡的 Border 背景一起拉宽，
                    变成一条通栏色块而不是贴着文字的气泡；同时方向还要跟气泡本身该贴哪一侧一致
                    （我方贴右、对方贴左），所以用跟外层 StackPanel 同一个转换器。
                -->
                <ContentControl Content="{Binding}"
                                 HorizontalAlignment="{Binding IsMine, Converter={StaticResource MineToAlignmentConverter}}"
                                 HorizontalContentAlignment="Left"
                                 ContentTemplateSelector="{StaticResource BubbleContentTemplateSelector}" />

                <TextBlock Text="发送中…"
                           FontSize="{ThemeResource FontCaption}"
                           Margin="4,3,4,0"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="! 发送失败，点击重发"
                           FontSize="{ThemeResource FontCaption}"
                           Margin="4,3,4,0"
                           HorizontalAlignment="Right"
                           Foreground="{ThemeResource UnreadBadgeBrush}"
                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!-- 我方头像：昵称/主色跟着消息走，不写死（消息里已经带 SelfNickname 和主题主色） -->
            <controls:AvatarView Grid.Column="2"
                                  DisplayName="{Binding SenderName}"
                                  AccentColorHex="{Binding SenderAvatar}"
                                  Size="40"
                                  VerticalAlignment="Top"
                                  Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
    </DataTemplate>

    <!-- ============ 行级选择器：日期分隔线 / 系统提示 / 普通气泡行 三选一 ============ -->
    <common:MessageRowTemplateSelector x:Key="MessageRowTemplateSelector"
                                        DateDividerRowTemplate="{StaticResource DateDividerRowTemplate}"
                                        SystemNoticeRowTemplate="{StaticResource SystemNoticeRowTemplate}"
                                        BubbleRowTemplate="{StaticResource BubbleRowTemplate}" />

</ResourceDictionary>
