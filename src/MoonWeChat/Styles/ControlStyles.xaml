<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
    </Style>
    <Style x:Key="FlatListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource OnAccentTextBrush}"/>
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource FontTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource FontBody}"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource FontCaption}"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
    </Style>
    <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>
    <Style x:Key="BottomTabToggleStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
</ResourceDictionary>
