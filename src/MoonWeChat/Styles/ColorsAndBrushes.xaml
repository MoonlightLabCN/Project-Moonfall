<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        整套颜色资源统一放进 Light / Dark 两个 ThemeDictionary，即使有些颜色（比如微信绿、
        我方气泡色）在两套主题下数值其实一样，也各写一份。
        这样做纯粹是为了让所有引用方一律用 {ThemeResource X}：
        ThemeResource 是运行时按当前主题、沿实时可视树向上查找的，天然跨文件安全；
        而 StaticResource 引用“另一个资源”时，只能在同一个文件（含它自己显式合并进来的文件）里查找，
        跨文件引用容易踩坑。为了这套多文件资源字典能稳定工作，这里全部收敛成 ThemeResource 一种用法。
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChatWallpaperBrush" Color="#EDEDED" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B8B8B" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="TheirBubbleBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="InputBarBackgroundBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="InputBoxBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1F1A1A1A" />

            <SolidColorBrush x:Key="AccentBrush" Color="#07C160" />
            <SolidColorBrush x:Key="MineBubbleBrush" Color="#95EC69" />
            <SolidColorBrush x:Key="OnMineBubbleTextBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="UnreadBadgeBrush" Color="#FA5151" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ChatWallpaperBrush" Color="#0D0D0D" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#161616" />
            <SolidColorBrush x:Key="ListBackgroundBrush" Color="#111111" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#212121" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8E8E8E" />
            <SolidColorBrush x:Key="DividerBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="TheirBubbleBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="InputBarBackgroundBrush" Color="#161616" />
            <SolidColorBrush x:Key="InputBoxBackgroundBrush" Color="#232323" />
            <SolidColorBrush x:Key="PillBackgroundBrush" Color="#33FFFFFF" />

            <SolidColorBrush x:Key="AccentBrush" Color="#07C160" />
            <SolidColorBrush x:Key="MineBubbleBrush" Color="#7BC950" />
            <SolidColorBrush x:Key="OnMineBubbleTextBrush" Color="#101A10" />
            <SolidColorBrush x:Key="UnreadBadgeBrush" Color="#FA5151" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
