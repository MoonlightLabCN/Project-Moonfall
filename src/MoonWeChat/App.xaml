<Application
    x:Class="MoonWeChat.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 颜色皮肤：启动后 ThemeService 会按设置换成 Win10 / WP 经典 -->
                <ResourceDictionary Source="ms-appx:///Styles/Themes/Win10Theme.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/MessageBubbleTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
