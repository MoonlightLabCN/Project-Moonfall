<Page
    x:Class="MoonWeChat.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="48" Padding="4,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Click="OnBackClick">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="服务器设置" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,16,16,24" MaxWidth="520">
                <TextBlock Text="数据源" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <CheckBox x:Name="UseSampleCheck" Content="使用本地示例数据（不连后端）"
                          Margin="0,6,0,12" Click="OnUseSampleClick" />

                <TextBlock Text="WeChatPadPro 地址" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="BaseUrlBox" Margin="0,4,0,12"
                         PlaceholderText="http://192.168.1.10:1239"
                         Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay}"
                         TextChanged="OnBaseUrlChanged" />

                <TextBlock Text="AdminKey（仅用于生成 Token）" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <PasswordBox x:Name="AdminKeyBox" Margin="0,4,0,4"
                             PasswordRevealMode="Peek" />
                <Button Content="用 AdminKey 生成 Token" Margin="0,0,0,12"
                        Command="{x:Bind ViewModel.GenTokenCommand}" />

                <TextBlock Text="Token（业务鉴权码）" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="TokenBox" Margin="0,4,0,12"
                         PlaceholderText="授权码"
                         Text="{x:Bind ViewModel.Token, Mode=TwoWay}"
                         TextChanged="OnTokenChanged" />

                <TextBlock Text="当前 wxid（扫码登录后自动写入，也可手填）" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="WxIdBox" Margin="0,4,0,12"
                         PlaceholderText="wxid_..."
                         Text="{x:Bind ViewModel.WxId, Mode=TwoWay}"
                         TextChanged="OnWxIdChanged" />

                <TextBlock Text="代理（可选，云服务器登录时可能需要）" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="ProxyBox" Margin="0,4,0,12"
                         PlaceholderText="http://user:pass@host:port"
                         Text="{x:Bind ViewModel.Proxy, Mode=TwoWay}"
                         TextChanged="OnProxyChanged" />

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"
                           Foreground="{ThemeResource PrimaryTextBrush}" />

                <Button Content="测试连通" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Command="{x:Bind ViewModel.TestCommand}" />
                <Button Content="查询在线状态" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Command="{x:Bind ViewModel.OnlineStatusCommand}" />
                <Button Content="保存" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Style="{StaticResource SendButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="重新配置远程服务器" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="OnGoConnectClick" />
                <Button Content="去扫码登录" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="OnGoLoginClick" />
                <Button Content="清除本机登录态" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Command="{x:Bind ViewModel.ClearSessionCommand}" />
                <Button Content="回到欢迎页" HorizontalAlignment="Stretch"
                        Click="OnWelcomeClick" />

                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Text="WP 端只连远程 WeChatPadPro。收消息默认轮询 /Msg/Sync。路径对齐 wx.knowhub.cloud 文档（/Admin/GenAuthKey、/Login/GetQRMac、/Login/CheckMacQR、/Login/Newinit、/Friend/GetContractList、/Msg/SendTxt）。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
