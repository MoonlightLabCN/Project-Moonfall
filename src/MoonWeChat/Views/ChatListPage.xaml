<Page
    x:Class="MoonWeChat.Views.ChatListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoonWeChat.Views"
    xmlns:controls="using:MoonWeChat.Controls"
    xmlns:models="using:MoonWeChat.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MoonWeChat.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <Page.Resources>
        <!-- 页面级别的转换器，只在本页用，避免依赖别的资源字典的内部实现细节。 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <!--
        “微信”主页：最近会话列表。这是整个第三方客户端的默认首页。
        列表项字段（置顶/免打扰/未读数/群人数/最后一条消息预览）都对应
        docs/WeChatPadPro-API-notes.md 里通讯录同步 + Webhook 消息推送能给到的数据，
        没有凭空加字段。视觉上按 10586 时代的扁平 Metro 风格：直角无圆角，间距用 Margin。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="48" Padding="16,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="微信" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnRefreshClick"
                            ToolTipService.ToolTip="刷新">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0" Click="OnSearchClick"
                            ToolTipService.ToolTip="搜索">
                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0" Click="OnSettingsClick"
                            ToolTipService.ToolTip="设置 / 登录">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="连接远程服务器" Click="OnConnectClick" />
                                <MenuFlyoutItem Text="扫码登录" Click="OnLoginClick" />
                                <MenuFlyoutItem Text="设置" Click="OnSettingsClick" />
                                <MenuFlyoutItem Text="发起群聊" Click="OnMenuItemClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 服务器掉线 / 不可达时提示重扫；Token 仍保留 -->
        <Border Grid.Row="1" Background="#FFF3CD" Padding="12,10"
                BorderBrush="#FFEEBA" BorderThickness="0,0,0,1"
                Visibility="{x:Bind ViewModel.ShowBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Tapped="OnBannerTapped">
            <TextBlock Text="{x:Bind ViewModel.BannerText, Mode=OneWay}"
                       TextWrapping="Wrap" FontSize="12" Foreground="#856404" />
        </Border>

        <!-- 会话列表 -->
        <ListView Grid.Row="2"
                  x:Name="SessionListView"
                  ItemsSource="{x:Bind ViewModel.Sessions}"
                  IsItemClickEnabled="True"
                  ItemClick="OnSessionClicked"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource FlatListViewItemStyle}"
                  Padding="0,4,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatSession">
                    <Grid Padding="12,10" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 头像 + 未读角标 -->
                        <Grid Grid.Column="0">
                            <controls:AvatarView DisplayName="{x:Bind DisplayName}"
                                                  AccentColorHex="{x:Bind AvatarAccentColor}"
                                                  ImageUrl="{x:Bind AvatarUrl}"
                                                  Size="48" />
                            <Border Background="{ThemeResource UnreadBadgeBrush}"
                                    MinWidth="16" Height="16"
                                    Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-4,0"
                                    Visibility="{x:Bind ShowUnreadNumber, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind UnreadBadgeText}" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Fill="{ThemeResource SecondaryTextBrush}" Width="9" Height="9"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                     Visibility="{x:Bind ShowMutedDot, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <!-- 名称 + 最后一条消息预览 -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="15.5"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                          Margin="4,0,0,0"
                                          Foreground="{ThemeResource SecondaryTextBrush}"
                                          VerticalAlignment="Center"
                                          Visibility="{x:Bind IsMuted, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind PreviewText}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <!-- 时间 + 置顶图钉 -->
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind LastMessageTimeText}" FontSize="11"
                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                            <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Margin="0,6,0,0"
                                      HorizontalAlignment="Right"
                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                      Visibility="{x:Bind IsPinned, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部四个 Tab -->
        <controls:BottomTabBar Grid.Row="3" x:Name="TabBar" TabSelected="OnTabSelected" />
    </Grid>
</Page>
