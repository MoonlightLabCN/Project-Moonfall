<Page x:Class="MoonWeChat.Views.MomentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:MoonWeChat.Models" Background="{ThemeResource ListBackgroundBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{ThemeResource ChromeBackgroundBrush}" Padding="16,0" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid MinHeight="{ThemeResource ChromeBarHeight}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="朋友圈" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnRefreshClick"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontIcon}"/></Button></Grid>
    </Border>
    <StackPanel Grid.Row="1" Padding="16,12"><TextBox x:Name="DraftBox" PlaceholderText="分享此刻…" AcceptsReturn="True" TextChanged="OnDraftChanged"/><Button Content="发布" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnPublishClick"/></StackPanel>
    <TextBlock Grid.Row="2" x:Name="LocalStatusText" Style="{StaticResource CaptionTextStyle}" Margin="16,0,16,8" TextWrapping="Wrap"/>
    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Posts, Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="models:MomentPost"><Border Padding="16,12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{x:Bind AuthorName}" Style="{StaticResource BodyTextStyle}"/><TextBlock Text="{x:Bind Content}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
  </Grid>
</Page>
