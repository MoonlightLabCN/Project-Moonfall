<Page
    x:Class="MoonWeChat.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <!--
        目标体验：
        1) 填服务器 + Token
        2) 扫码登录一次
        3) 服务器长期在线 → 以后打开客户端直接进，不用再管登录
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="48" Padding="4,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Click="OnBackClick">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <TextBlock Grid.Column="1" Text="连接并登录" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnOpenSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,18,20,28" MaxWidth="440">

                <Border Background="{ThemeResource ChromeBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                        Padding="12" Margin="0,0,0,14">
                    <TextBlock Text="{x:Bind ViewModel.PersistHint, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}" />
                </Border>

                <TextBlock Text="1. 服务器地址" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBox x:Name="ServerBox" Margin="0,6,0,0"
                         PlaceholderText="http://192.168.1.10:1238 或 127.0.0.1:1238"
                         Text="{x:Bind ViewModel.ServerUrl, Mode=OneWay}"
                         TextChanged="OnServerTextChanged" />
                <TextBlock Text="{x:Bind ViewModel.NormalizedUrlHint, Mode=OneWay}"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}" />

                <TextBlock Text="2. Token" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="业务鉴权码，扫码登录绑定在这个 Token 上。请长期固定使用同一个。"
                           TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBox x:Name="TokenBox" Margin="0,6,0,0"
                         PlaceholderText="粘贴 Token"
                         Text="{x:Bind ViewModel.Token, Mode=OneWay}"
                         TextChanged="OnTokenTextChanged" />

                <Button x:Name="StartButton" Content="扫码登录"
                        Margin="0,16,0,0" HorizontalAlignment="Stretch"
                        Style="{StaticResource SendButtonStyle}"
                        Command="{x:Bind ViewModel.StartLoginCommand}" />

                <Border Background="{ThemeResource ChromeBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                        Margin="0,18,0,0" Padding="16" HorizontalAlignment="Center">
                    <Grid Width="240" Height="240">
                        <Image Stretch="Uniform" Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" />
                        <StackPanel x:Name="QrPlaceholder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="二维码显示在这里"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource ChromeBackgroundBrush}"
                        BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1"
                        Margin="0,14,0,0" Padding="12">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                </Border>

                <Button Content="高级：AdminKey 生成 Token / 代理" Margin="0,14,0,0"
                        HorizontalAlignment="Stretch" Padding="12,8"
                        Click="OnToggleAdvancedClick" />

                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="AdminKey（仅生成 Token 时用）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <PasswordBox x:Name="AdminKeyBox" Margin="0,4,0,8"
                                 PasswordChanged="OnAdminKeyChanged" />
                    <Button Content="生成 Token 并填入" Margin="0,0,0,12"
                            HorizontalAlignment="Stretch" Padding="12,8"
                            Command="{x:Bind ViewModel.GenTokenCommand}" />

                    <TextBlock Text="代理（可选）" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBox x:Name="ProxyBox" Margin="0,4,0,0"
                             PlaceholderText="http://user:pass@host:port"
                             Text="{x:Bind ViewModel.Proxy, Mode=OneWay}"
                             TextChanged="OnProxyTextChanged" />
                </StackPanel>

                <Button x:Name="EnterAppButton" Content="进入会话列表（已登录）"
                        Margin="0,12,0,0" HorizontalAlignment="Stretch"
                        Style="{StaticResource SendButtonStyle}"
                        Click="OnEnterAppClick" Visibility="Collapsed" />

                <Button x:Name="SkipIfLoggedButton" Content="已登录，直接进入"
                        Margin="0,8,0,0" HorizontalAlignment="Stretch" Padding="12,10"
                        Click="OnEnterAppClick" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
