<Page
    x:Class="MoonWeChat.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonWeChat.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                       Padding="16,0" Height="48" VerticalAlignment="Center"
                       Foreground="{ThemeResource PrimaryTextBrush}" />
        </Border>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
            <FontIcon Glyph="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                      Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="HintText" FontSize="14" Margin="0,10,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel x:Name="MeActions" Visibility="Collapsed" Margin="0,20,0,0" HorizontalAlignment="Center">
                <Button Content="服务器设置" Width="200" Margin="0,0,0,8" Click="OnSettingsClick" />
                <Button Content="扫码登录" Width="200" Margin="0,0,0,8"
                        Style="{StaticResource SendButtonStyle}" Click="OnLoginClick" />
            </StackPanel>
        </StackPanel>

        <controls:BottomTabBar Grid.Row="2" x:Name="TabBar" TabSelected="OnTabSelected" />
    </Grid>
</Page>
