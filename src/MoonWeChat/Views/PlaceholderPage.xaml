<Page x:Class="MoonWeChat.Views.PlaceholderPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ListBackgroundBrush}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{ThemeResource ChromeBackgroundBrush}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1"><TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" Padding="16,0" Height="{ThemeResource ChromeBarHeight}" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24"><FontIcon Glyph="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontIcon}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="HintText" FontSize="{ThemeResource FontSubtitle}" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/><StackPanel x:Name="MeActions" Visibility="Collapsed" Margin="0,20,0,0" HorizontalAlignment="Center"><Button Content="服务器设置" Width="200" Margin="0,0,0,8" Click="OnSettingsClick"/><Button Content="扫码登录" Width="200" Style="{StaticResource SendButtonStyle}" Click="OnLoginClick"/></StackPanel></StackPanel>
  </Grid>
</Page>
