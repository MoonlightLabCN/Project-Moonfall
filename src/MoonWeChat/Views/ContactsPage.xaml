<Page
    x:Class="MoonWeChat.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MoonWeChat.Controls"
    xmlns:models="using:MoonWeChat.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MoonWeChat.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ListBackgroundBrush}">

    <Page.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Page.Resources>

    <!-- 通讯录：对应 WeChatPadPro 的好友列表/详情接口，字段见 docs/WeChatPadPro-API-notes.md 第4节。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ChromeBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Height="48" Padding="16,0">
                <TextBlock Text="通讯录" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" Background="{ThemeResource ListBackgroundBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索微信号 / 手机号（远程）"
                         BorderThickness="0" Background="{ThemeResource InputBoxBackgroundBrush}"
                         Padding="10,8" />
                <Button Grid.Column="1" Content="搜索" Margin="8,0,0,0" Padding="12,8"
                        Click="OnSearchClick" />
            </Grid>
        </Border>

        <ListView Grid.Row="2"
                  x:Name="ContactListView"
                  ItemsSource="{x:Bind Contacts}"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource FlatListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Contact">
                    <Grid Padding="12,10" MinHeight="60">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:AvatarView Grid.Column="0"
                                              DisplayName="{x:Bind DisplayName}"
                                              AccentColorHex="{x:Bind AvatarAccentColor}"
                                              ImageUrl="{x:Bind AvatarUrl}"
                                              Size="44" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="15"
                                       Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind Signature}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind Signature, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:BottomTabBar Grid.Row="3" x:Name="TabBar" TabSelected="OnTabSelected" />
    </Grid>
</Page>
