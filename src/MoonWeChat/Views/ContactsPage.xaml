<Page x:Class="MoonWeChat.Views.ContactsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:MoonWeChat.Models" xmlns:controls="using:MoonWeChat.Controls" xmlns:common="using:MoonWeChat.Common" Background="{ThemeResource ListBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{ThemeResource ChromeBackgroundBrush}" Padding="16,0" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid MinHeight="{ThemeResource ChromeBarHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="通讯录" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnSearchClick">
                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{ThemeResource FontIcon}"/>
                </Button>
            </Grid>
        </Border>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Contacts, Mode=OneWay}" ItemContainerStyle="{StaticResource FlatListViewItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnContactClicked">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Contact">
                    <Grid Padding="16,10" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AvatarView DisplayName="{x:Bind DisplayName}" AccentColorHex="{x:Bind AvatarAccentColor}" ImageUrl="{x:Bind AvatarUrl}" Size="44"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="{x:Bind Signature}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
